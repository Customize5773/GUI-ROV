# =========================================================================
# HYDROSHIP GUI-ROV — contoh konfigurasi environment
#
#   cp .env.example .env
#
# Semua nilai di bawah ini adalah DEFAULT yang sudah dipakai kode; file ini
# hanya membuatnya eksplisit supaya anggota tim bisa mengubahnya tanpa
# menyunting source. `.env` TIDAK di-commit (lihat .gitignore).
#
# Cara pakai:
#   - `./start-gui.sh` / `./start-gui.sh sim` otomatis memuat `.env` bila ada.
#   - Manual (shell POSIX):  set -a; . ./.env; set +a
#   - Untuk rov_agent.py di Raspberry Pi: sumber file ini di systemd unit
#     (`EnvironmentFile=/home/pi/GUI-ROV/.env`) atau ekspor sebelum menjalankan.
# =========================================================================

# ------------------------------------------------------------------
# Server GUI (server/server.js, server/recording.js, joystick-config.js)
# ------------------------------------------------------------------

# Port HTTP + WebSocket dashboard.
WS_PORT=8080

# Port UDP tempat server MENDENGAR telemetri JSON dari ROV.
UDP_IN=14551

# Port UDP tujuan command JSON ke ROV.
UDP_OUT=14550

# Alamat Raspberry Pi di sisi ROV.
# CATATAN: kalau laptop Anda tidak sesubnet dengan RPI (mis. laptop di
# 192.168.67.x sedangkan RPI di 192.168.2.2), pakai mode sim untuk sesi coding:
#   ./start-gui.sh sim
# Di mode sim nilai ini tidak dipakai; isi 127.0.0.1 kalau ingin menghindari
# log "gagal kirim command" ke alamat yang tidak terjangkau.
RPI_ADDR=192.168.2.2

# Izinkan proxy /cam ke host kamera mana pun (1 = ya). Default aman: 0.
CAM_ALLOW_ANY=0

# Direktori penyimpanan rekaman. Kosong = server/recordings.
HYDROSHIP_RECORDINGS_DIR=

# Durasi maksimum satu rekaman (menit).
MAX_RECORD_MIN=15

# Direktori profil joystick tersimpan. Kosong = lokasi config OS
# (XDG_CONFIG_HOME/hydroship di Linux, APPDATA/hydroship di Windows).
HYDROSHIP_CONFIG_DIR=

# ------------------------------------------------------------------
# Agent sisi ROV (rov_agent.py, dijalankan di Raspberry Pi)
# ------------------------------------------------------------------

# IP laptop / ground station tujuan telemetri.
LAPTOP_IP=192.168.2.1

# Port serial Pixhawk dan baud rate-nya.
PIXHAWK_PORT=/dev/ttyACM0
PIXHAWK_BAUD=115200
